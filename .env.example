# Meta Model API key. Get it from dev.meta.ai after hackathon acceptance.
MODEL_API_KEY=
META_API_BASE=https://api.meta.ai/v1

# Models
SAM_MODEL=sam-3.1
SPARK_MODEL=muse-spark-1.3

# Pipeline
SS_DB=data/db/spatialsight.sqlite
SS_CACHE=data/cache

# Required on this machine: OpenBLAS crashes numpy with >1 thread.
OPENBLAS_NUM_THREADS=1
# Required on this machine: a global pip --target/PYTHONPATH would shadow the venv.
PYTHONPATH=

# ---- Optional: a free text model, before the Meta key arrives ---------------
# Any OpenAI-compatible endpoint. Leave unset to use Muse Spark above.
#
# Local, Meta open weights (Llama 3.2 3B via llama.cpp, see scripts/llm):
#   LLM_BASE_URL=http://127.0.0.1:8080/v1
#   LLM_MODEL=llama-3.2-3b
#
# Hosted free tier serving a Meta model (Groq, Llama 3.3 70B):
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
#   LLM_API_KEY=gsk_...
#
# LLM_API_STYLE=chat   # 'responses' for the Meta API, 'chat' for the others

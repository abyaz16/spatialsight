#!/usr/bin/env bash
# Run the SpatialSight CLI with the environment this machine needs.
set -euo pipefail
cd "$(dirname "$0")/.."
export PYTHONPATH=""
export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-1}"
[ -f .env ] && set -a && . ./.env && set +a
exec ./.venv/Scripts/python.exe -m spatialsight.cli "$@"
